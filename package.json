  "homepage": "https://github.com/investblog/hexagons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/investblog/hexagons.git"
  },
  "bugs": {
    "url": "https://github.com/investblog/hexagons/issues"
  },
  "devDependencies": {
    "eslint": "^9.39.4",
    "terser": "^5.37.0"
  }
}
